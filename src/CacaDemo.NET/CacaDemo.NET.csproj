<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cacademo</AssemblyName>
    <RootNamespace>CacaDemo</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LibCaca\LibCaca.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 256x256 BGRA texture used by the rotozoom effect, converted from
         libcaca's src/texture.h. -->
    <EmbeddedResource Include="texture.bin" LogicalName="texture.bin" />
  </ItemGroup>

</Project>
