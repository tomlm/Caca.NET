<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A managed port of the parts of libcaca that cacademo uses: the canvas and
    its drawing primitives, the bitmap dithering engine, and a terminal driver.
    No native library is involved.

    libcaca is Copyright (c) 2002-2018 Sam Hocevar and contributors, and is
    distributed under the WTFPL; so is this port.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LibCaca</AssemblyName>
    <RootNamespace>Caca</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
